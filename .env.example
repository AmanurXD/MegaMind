# Preferred multi-post setup. Generate each value with:
# npm run format-request < raw-request-city-1.txt
RAW_REQUEST_1_BASE64=replace-with-city-1-capture-base64
RAW_REQUEST_2_BASE64=replace-with-city-2-capture-base64
CITY_1_LABEL=City One
CITY_2_LABEL=City Two

# Older single-post envs still work:
# RAW_REQUEST_BASE64=replace-with-one-capture-base64
# RAW_REQUEST_BLOB=GET /users/posts/bump/12345678 HTTP/2\nHost: megapersonals.eu\nCookie: sid=replace-me

PORT=3000

# The worker makes one dynamic post pick per success cooldown frame.
SUCCESS_COOLDOWN_MS=910000
RETRY_MS=60000
NETWORK_ERROR_RETRY_MS=30000
REQUEST_TIMEOUT_MS=30000

# Test-only local fake server routing. Leave disabled in production.
# MEGAMIND_TEST_MODE=1
# MEGAMIND_TEST_HOST=127.0.0.1
# MEGAMIND_TEST_PORT=3998
